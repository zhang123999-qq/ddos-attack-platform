# Attacker Node Configuration
# Copy to config.env and modify per node

# Node Identity
NODE_ID=attacker-http-01
NODE_TYPE=http  # http, raw, mixed
NODE_LABELS=role=http-attacker,zone=dmz

# Controller Connection
CONTROLLER_URL=https://10.100.1.10:8443
CONTROLLER_CA_CERT=/certs/ca-cert.pem
NODE_CERT=/certs/node-cert.pem
NODE_KEY=/certs/node-key.pem
# 预共享 Token (由 Controller 生成，或手动配置)
NODE_TOKEN=  # 留空则使用 SHARED_SECRET 派生

# Attack Capabilities (逗号分隔)
# http_flood, slowloris -> 普通权限
# syn_flood, udp_flood, udp_reflection -> 需 CAP_NET_RAW
ATTACK_TYPES=http_flood,slowloris

# Resource Limits (节点自限流上限)
MAX_RPS=10000
MAX_PPS=50000
MAX_CONCURRENT=5000

# Network Interface (RAW 攻击需要指定)
NETWORK_INTERFACE=eth0

# Health Report Interval
HEARTBEAT_INTERVAL=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json