# Controller Configuration
# Copy to config.env and modify

# Controller Network
CONTROLLER_IP=10.100.1.10
CONTROLLER_PORT=8443
CONTROLLER_HOST=0.0.0.0

# Security
# 生成后自动填充: ./generate_certs.sh
TLS_CERT_FILE=/certs/controller-cert.pem
TLS_KEY_FILE=/certs/controller-key.pem
TLS_CA_FILE=/certs/ca-cert.pem
# 预共享 Token (Controller <-> Attacker 节点认证)
SHARED_SECRET=change-this-to-a-long-random-string-32chars-min

# Target Allowlist (CIDR 列表，逗号分隔)
# 仅允许攻击这些网段内的目标
ALLOWED_TARGET_CIDRS=10.100.0.0/16,192.168.0.0/16

# Rate Limits (全局聚合上限)
GLOBAL_MAX_RPS=50000
GLOBAL_MAX_PPS=100000
GLOBAL_MAX_CONCURRENT_CONNECTIONS=100000

# Audit
AUDIT_LOG_PATH=/var/log/ddos-audit/audit.jsonl
AUDIT_LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=90

# Scenario Defaults
DEFAULT_ATTACK_DURATION=300
DEFAULT_RAMP_UP_SECONDS=30

# Web UI (可选)
ENABLE_WEB_UI=true
WEB_UI_PORT=8443

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json