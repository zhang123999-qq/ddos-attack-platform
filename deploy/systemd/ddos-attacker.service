[Unit]
Description=DDoS Attack Platform - Attacker Node
Documentation=https://github.com/your-org/ddos-attack-platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ddos
Group=ddos
WorkingDirectory=/opt/ddos-attack-platform/attacker
ExecStart=/opt/ddos-attack-platform/attacker/ddos-attacker
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=15

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ddos-attack-platform/attacker
ReadOnlyPaths=/etc/ssl/certs

# 环境变量
EnvironmentFile=-/opt/ddos-attack-platform/attacker/config.env
Environment=NODE_ID=attacker-http-01
Environment=NODE_TYPE=http
Environment=ATTACK_TYPES=http_flood,slowloris

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ddos-attacker

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# v1.5.0 (R-NEW-3): OOM 防护 — 攻击节点在错误风暴时易触发 OOM
# attacker 节点 MemoryMax 默认 2G (节点常驻连接 + 大并发需要更多内存)
# OOMPolicy=stop: 优雅停止, Restart=always 自动拉起 (避免 OOM 后半残状态)
# OOMScoreAdjust=-300: 优先级高于 controller (节点可被 OOM 但 controller 必须存活)
MemoryMax=2G
MemoryHigh=1536M
OOMPolicy=stop
OOMScoreAdjust=-300

[Install]
WantedBy=multi-user.target