[Unit]
Description=DDoS Attack Platform - Controller
Documentation=https://github.com/your-org/ddos-attack-platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ddos
Group=ddos
WorkingDirectory=/opt/ddos-attack-platform/controller
ExecStart=/opt/ddos-attack-platform/controller/ddos-controller
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=10

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ddos-attack-platform/controller
ReadOnlyPaths=/etc/ssl/certs

# 环境变量
EnvironmentFile=-/opt/ddos-attack-platform/controller/config.env
Environment=CONTROLLER_PORT=8443
Environment=CONTROLLER_HOST=0.0.0.0
Environment=AUDIT_LOG_PATH=/opt/ddos-attack-platform/controller/audit.jsonl
Environment=ENABLE_WEB_UI=true

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ddos-controller

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target