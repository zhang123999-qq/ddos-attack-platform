[Unit]
Description=DDoS Attack Platform - Controller
Documentation=https://github.com/your-org/ddos-attack-platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ddos
Group=ddos
WorkingDirectory=/opt/ddos-attack-platform/controller
ExecStart=/opt/ddos-attack-platform/controller/ddos-controller
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=10

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ddos-attack-platform/controller
ReadOnlyPaths=/etc/ssl/certs

# 环境变量
EnvironmentFile=-/opt/ddos-attack-platform/controller/config.env
Environment=CONTROLLER_PORT=8443
Environment=CONTROLLER_HOST=0.0.0.0
Environment=AUDIT_LOG_PATH=/opt/ddos-attack-platform/controller/audit.jsonl
Environment=ENABLE_WEB_UI=true

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ddos-controller

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# v1.5.0 (R-NEW-3): OOM 防护 — 防止攻击风暴下 OOM killer 杀掉 controller 留下半残状态
# MemoryMax: 软上限, 超过触发回收 (默认 1G, 可被 EnvironmentFile 覆盖)
# MemoryHigh: 主动回收阈值
# OOMPolicy=stop: OOM 时优雅停止 (而非 SIGKILL), 让 Restart=always 自动拉起
# OOMScoreAdjust=-200: 降低被 OOM killer 选中的概率
MemoryMax=1G
MemoryHigh=768M
OOMPolicy=stop
OOMScoreAdjust=-200

[Install]
WantedBy=multi-user.target