# DDoS Attack Platform - 统一配置模板
# 复制为各节点的 config.env 并修改

# ========== 网络配置 ==========
# 控制器 IP (所有节点必须可达)
CONTROLLER_IP=10.100.1.10
CONTROLLER_URL=https://10.100.1.10:8443

# 允许攻击的目标网段 (CIDR，逗号分隔)
# 重要：仅包含授权演练网段！
ALLOWED_TARGET_CIDRS=10.100.0.0/16,192.168.0.0/16

# ========== 安全配置 ==========
# 预共享密钥 (32字节十六进制，Controller 和所有 Attacker 必须一致)
# 生成: openssl rand -hex 32
SHARED_SECRET=your-32-byte-hex-secret-here-change-me

# ========== 全局限流 (Controller 侧聚合) ==========
GLOBAL_MAX_RPS=50000
GLOBAL_MAX_PPS=100000
GLOBAL_MAX_CONCURRENT_CONNECTIONS=100000

# ========== 节点通用配置 ==========
# 心跳间隔(秒)
HEARTBEAT_INTERVAL=10

# 日志级别
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========== Controller 专用 ==========
# CONTROLLER_HOST=0.0.0.0
# CONTROLLER_PORT=8443
# TLS_CERT_FILE=/certs/controller-cert.pem
# TLS_KEY_FILE=/certs/controller-key.pem
# TLS_CA_FILE=/certs/ca-cert.pem
# AUDIT_LOG_PATH=/var/log/ddos-audit/audit.jsonl
# AUDIT_RETENTION_DAYS=90
# ENABLE_WEB_UI=true

# ========== Attacker HTTP/Slowloris 节点 ==========
