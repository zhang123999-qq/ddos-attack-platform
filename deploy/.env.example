# =============================================================================
# DDoS Attack Platform — 部署环境变量 (复制为 .env 并修改)
# =============================================================================

# ---------- 必填 ----------
# 预共享密钥 (openssl rand -hex 32)
SHARED_SECRET=change-this-to-a-random-hex-string-at-least-32-bytes

# Controller 可达 IP
CONTROLLER_IP=10.100.1.10

# ---------- 安全 ----------
# 允许攻击的 CIDR 网段 (逗号分隔)
ALLOWED_TARGET_CIDRS=10.100.0.0/16,192.168.0.0/16

# ---------- 全局限流 ----------
GLOBAL_MAX_RPS=50000
GLOBAL_MAX_PPS=100000
GLOBAL_MAX_CONCURRENT_CONNECTIONS=100000

# ---------- 节点标识 ----------
# Attacker HTTP 节点
NODE_ID=attacker-http-01
NODE_TYPE=http
NODE_LABELS=role=http-attacker,zone=dmz
ATTACK_TYPES=http_flood,slowloris
MAX_RPS=10000
MAX_CONCURRENT=5000

# Attacker RAW 节点
# NODE_ID=attacker-raw-01
# NODE_TYPE=raw
# NODE_LABELS=role=raw-attacker,zone=dmz
# ATTACK_TYPES=syn_flood,udp_flood,udp_reflection
# MAX_PPS=50000
# NETWORK_INTERFACE=eth0

# ---------- 容器注册表 ----------
REGISTRY=ghcr.io/your-org
VERSION=latest

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 路径 (Docker) ----------
CERTS_DIR=./certs
AUDIT_DIR=./audit-logs
SCENARIOS_DIR=./scenarios