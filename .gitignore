# OpenClaw/ClawX workspace ignores
memory/*.md
!memory/YYYY-MM-DD.md
*.log
*.sqlite
*.bak
*.last-good
node_modules/
__pycache__/
*.pyc
.env
*.key
*.pem
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.egg
*.whl
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Test artifacts (TLS E2E 临时证书)
controller/tests/_tmp_certs/
attacker/tests/_tmp_certs/

# Build artifacts
build/_*build/
*.spec.bak

# IDE
.vscode/
.idea/
*.swp
*.swo

# Config files (contains secrets)
config.env
*.env
!config.env.example
!*.env.example

# Certificates (contains private keys)
certs/
!deploy/certs/.gitkeep
!certs/.gitkeep

# Logs
*.log
audit.jsonl
/var/

# Generated configs (secrets — keep directory, ignore .env)
generated/*.env

# OS
.DS_Store
Thumbs.db

# Foreign workspace tool state (keep out of this platform repo)
memory/
openclaw-workspace-state.json
AGENTS.md
